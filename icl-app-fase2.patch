+import {
+  SolicitarUploadUrlBody,
+  SolicitarUploadUrlResponse,
+} from "@workspace/api-zod";
+import { Router, type IRouter } from "express";
+import { optionalAuth } from "../lib/auth";
+import { ObjectStorageService } from "../lib/objectStorage";
+import { validar } from "../lib/validar";
+
+const router: IRouter = Router();
+const objectStorage = new ObjectStorageService();
+
+router.post("/storage/uploads/request-url", optionalAuth, async (req, res): Promise<void> => {
+  if (!req.userId && !req.sessionId) {
+    res.status(401).json({ erro: "Inicie uma sessão para anexar fotos." });
+    return;
+  }
+
+  const body = validar(SolicitarUploadUrlBody, req.body, res);
+  if (!body) return;
+
+  try {
+    const uploadUrl = await objectStorage.getObjectEntityUploadURL();
+    const response = SolicitarUploadUrlResponse.parse({
+      upload_url: uploadUrl,
+      object_path: objectStorage.normalizeObjectEntityPath(uploadUrl),
+    });
+    res.json(response);
+  } catch (error) {
+    req.log.error({ err: error }, "Não foi possível preparar o upload do anexo");
+    res.status(503).json({ erro: "Armazenamento de fotos indisponível no momento." });
+  }
+});
+
+export default router;
